# ====================================================
# QuantEngine -- example operator configuration.
#
# Copy to `.env` and fill in locally. NEVER commit a real
# `.env`: it is untracked by design (.gitignore covers
# `.env` / `.env.*`) and NEVER put replacement credentials
# into the repository -- provision them only via the local
# environment / deployment secret store.
#
# Paper mode needs NO credentials. LIVE execution additionally
# requires the Phase 11A gate (mode == LIVE, ALLOW_LIVE=true,
# LIVE_EXECUTE=true, authenticated Delta credentials).
# ====================================================

# Delta exchange credentials (leave empty unless the operator
# explicitly provisions them for an authorized host).
# Generic/production API credentials are separate from Testnet keys.
DELTA_API_KEY=
DELTA_API_SECRET=

# Base64-encoded 32-byte Ed25519 public key used to verify operator-signed testnet authorizations.
# Keep the matching private key outside QuantEngine; never put it in this file or repository.
QUANTENGINE_TESTNET_AUTH_PUBLIC_KEY=

# India Delta Testnet capture/experiment scripts use ONLY these names.
DELTA_INDIA_TESTNET_API_KEY=
DELTA_INDIA_TESTNET_API_SECRET=

SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=1m
PAPER_MODE=True
LIVE_MODE=False
ALLOW_LIVE=
LIVE_EXECUTE=
EXECUTION_MODE=
MAX_OPEN_TRADES=1
RISK_PER_TRADE=1.0
HISTORICAL_CANDLES=500
LOG_LEVEL=INFO
UNIVERSE=explicit
